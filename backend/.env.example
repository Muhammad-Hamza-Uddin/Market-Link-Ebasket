TZ=Asia/Karachi
PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/marketlink
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated Vite origins allowed by the API
CLIENT_URL=http://localhost:5173

# Demo seed accounts (change these outside local development)
SEED_ADMIN_EMAIL=admin@marketlink.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_FARMER_EMAIL=farmer@marketlink.test
SEED_FARMER_PASSWORD=Farmer123!
SEED_CUSTOMER_EMAIL=customer@marketlink.test
SEED_CUSTOMER_PASSWORD=Customer123!

# OpenRouter AI assistant. Keep the real key only in backend/.env; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
